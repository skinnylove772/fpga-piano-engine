//  当作普通 IO 用完全没问题。
IO_LOC "enc_a" 15;
IO_PORT "enc_a" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "enc_b" 16;
IO_PORT "enc_b" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "enc_sw" 17;
IO_PORT "enc_sw" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
