//     69/70 是**板子为 UART 专门留的通道**, 依据来自 Sipeed 官方 wiki:
//       "Onboard BL616 is used for downloading bitstream into FPGA, and it's
//        also used as USB to serial convertor to communicate FPGA with computer
//        via UART."   /  "USB to UART for FPGA"
//     而且本仓库的官方例程 D:\...\TangNano-20K-example-main\uart\src\top.cst
//     用的就是:
//         IO_LOC "uart_rx" 70;
//         IO_LOC "uart_tx" 69;
//     它的时钟参数也是 CLK_FRE=27 / BAUD=115200, 与本工程完全一致。
IO_LOC "uart_rx" 70;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "uart_tx" 69;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

